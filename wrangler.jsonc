{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 新站点：改 name、routes、database_name/id、bucket_name、queue 名称，再改 src/config/site.ts
  "name": "video-template",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SHOWCASE_MODE": "false",
    "AUTH_ENABLED": "true",
    "GENERATION_ENABLED": "true",
    "PAYMENTS_ENABLED": "true",
    "SHOWCASE_AUTH_ENABLED": "false",
    // 经验证的模板所有者邮箱 SHA-256；用户本身不写入前端或源码。
    "OWNER_INITIAL_CREDIT_EMAIL_HASH": "4ca86ba9504ce8f2158ce97259c71eb51a6a9c10102bfe824a269dd54af665f5",
    "APP_ENV": "development",
    "SITE_URL": "http://localhost:3000",
    // waffo | dodo | mock（mock 只允许非 production）
    "PAYMENT_PROVIDER": "mock",
    // fal | yir | hypit | mock（mock 只允许非 production）
    "VIDEO_PROVIDER": "mock",
    "HYPIT_BRIDGE_URL": "http://127.0.0.1:8788",
    "HYPIT_SITE_ID": "shrimpreel",
    // 管理员邮箱（逗号分隔）：登录即为管理员，同时接收举报、留言提醒和系统告警
    "ADMIN_EMAILS": "admin@example.com",
    // 交易邮件发件地址，域名须在 Cloudflare Email Service 完成 Onboard；留空 = 不发信（后台“邮件”页记为 skipped）
    "EMAIL_FROM": "noreply@example.com",
    "WAFFO_ENVIRONMENT": "test",
    // Waffo 店铺 ID（STO_xxx，公开）：订阅的客户门户要用；只卖积分包可以留空
    "WAFFO_STORE_ID": "",
    "DODO_ENVIRONMENT": "test",
    // 每个积分包、订阅套餐对应支付商的 product id（JSON：{"starter":"PROD_xxx","monthly":"PROD_yyy",...}）
    "WAFFO_PRODUCTS": "{}",
    "DODO_PRODUCTS": "{}",
    "GOOGLE_CLIENT_ID": "",
    // Cloudflare Turnstile 站点密钥（公开）；留空 = 不启用。启用时必须同时 `wrangler secret put TURNSTILE_SECRET_KEY`
    "TURNSTILE_SITE_KEY": "",
    // 上传图片审核：openai（需 OPENAI_API_KEY）| none | mock（mock 只允许非 production）
    "MODERATION_PROVIDER": "mock",
    // waffo | mock（mock 仅限本地；扫描和付款开关独立）
    "PROMPT_SCAN_PROVIDER": "mock"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "video-template",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "video-template-media" }],
  "kv_namespaces": [{ "binding": "KV", "id": "00000000000000000000000000000000" }],
  "queues": {
    "producers": [{ "binding": "VIDEO_QUEUE", "queue": "video-template-jobs" }],
    "consumers": [
      {
        "queue": "video-template-jobs",
        "max_batch_size": 5,
        "max_concurrency": 2,
        "max_batch_timeout": 2,
        "max_retries": 10,
        "dead_letter_queue": "video-template-jobs-dlq"
      },
      // 死信：同一个 Worker 消费，任务判失败、退积分，健康检查据此告警（src/server.ts 按 -dlq 后缀分流）
      { "queue": "video-template-jobs-dlq", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 }
    ]
  },
  "ratelimits": [
    { "name": "UPLOAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "GENERATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  // Cloudflare Email Service（交易邮件、管理员提醒）。本地 dev / e2e 只模拟发送；不要加 "remote": true，否则会真的发信
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["*/5 * * * *"] }
}
