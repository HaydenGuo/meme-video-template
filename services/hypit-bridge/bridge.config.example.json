        "reference-video": {
          "durations": [
            5,
            12,
            15
          ],
          "model": "mini",
          "resolution": "720p",
          "aspectRatio": "9:16",
          "imagePersonReference": true,
          "videoPersonReference": true,
          "prompt": "The person in the reference image performs the movement from the reference video. Preserve the reference video's timing and camera motion. Use the image to establish the person's appearance."
        }
      }
    }
  },
  "ffmpegConcurrency": 2
