{
  "host": "127.0.0.1",
  "port": 8788,
  "publicUrl": "http://127.0.0.1:8788",
  "mode": "mock",
  "dataDir": "./hypit/.hypit/bridge",
  "maxActive": 8,
  "maxQueued": 100,
  "maxAgeMs": 2100000,
  "retentionMs": 86400000,
  "maxStorageBytes": 2147483648,
  "projectRoot": "./hypit",
  "runtimeProfile": "./hypit/hypit.runtime.json",
  "sites": {
    "shrimpreel": {
      "mediaOrigins": [
        "http://127.0.0.1:3000",
        "http://localhost:3000"
      ],
